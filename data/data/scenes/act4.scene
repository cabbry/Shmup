

defaultMenu -1

# Act IV -- "Rain". THE FIRST ACT OF THE GAME THAT IS NOT ON A CLOCK.
#
# Acts I to III are timelines: every wave has an hour, and the level lasts what
# the author decided. This one is a CHAIN OF REACTIONS -- one seed wave in the
# enemies block, and after that each wave waits for the one before it to be
# gone. The consequence is the point: a party of four kills a wave faster than
# a lone player, so the act does not become a waiting room when there are more
# guns; it stays dense. Nobody tuned that. It falls out of writing "next" as a
# condition rather than a time.
#
# Its signature is the RED RAIN: three falls of homing seekers (enemyType 6),
# until now the finale boss's private weapon. They steer toward the nearest
# ship at a capped turn rate, so they are dodgeable, and they carry four points
# of hull, so they can be shot out of the sky instead. They tint themselves
# red-hot -- which against this act's grey-blue weather is the act's whole
# look. Each fall arrives in beats, from two or three rules sharing one
# trigger with different delays.
#
# It is also the exit test of the v4 pack format: written in data only, read by
# tools/packlint the way the game reads it, and it ends with a rule (endAct)
# rather than with a number.
#
# Decor, with no new asset: act 2's city and its shipped baked rail. The rail
# and the map are a PAIR -- a .cp2b stores per-frame face indices into that
# map's entities, so act 3's map (act 1's city) with act 3's rail (baked in
# 2009 for act 2's city, and 35 s long) would have culled the wrong faces on
# the wrong geometry. Act 2's flight is also the only one that shows this city
# in full: the finale spends nine seconds of it and then hovers.

map
{
	filename: data/map/act2.map
}

light
{
	enabled 0
	position : 5000 200 -5000 1
   lookAt   : 0 -200 -5000
   upVector : 1 0 0
   fov      : 70
   ambientColor  : 0.5 0.5 0.5
   diffuseColor  : 1.0 1.0 1.0

   speculaColor  : 1 1 1
   constantAttenuation: 1
   linearAttenuation: 0
   attachedToCamera: 0

}

camera
{
	path:  data/cameraPath/act2.cp.cp2b

	fov:	55
	zNear:	2
	zFar:	22000

	attachAt: 09000
	# No detachAt (4.0.2): the ships park at the end and stay visible under the
	# epilog card, like every other act.

	# A reactive act has NO KNOWN LENGTH -- it lasts as long as the players take
	# to clear seven waves, and two of them clear it faster than one. The rail
	# runs out at ~142 s, so hand over to the end-of-rail patrol instead of
	# freezing, exactly as the finale does while its fight drags on. This is the
	# camera setting that a level without a schedule requires.
	driftAtEnd: 1
}

# Rain: the city seen through weather. Same ramp start as acts 1/2 (starting it
# at the camera is what made the old act 3 needlessly dark), but the fog CLOSES
# EARLIER -- 300 against their 405 -- so the far towers dissolve and the near
# ones stay hard. Grey-blue, on the way down to the finale's deep water.
fog
{
	enabled 1
	density 0.1
	startAt 70
	endAt   300.0
	color:  0.05  0.06  0.10
}

player
{
	id 0
	matrix 1 0 0 -3
	       0 1 0 110
		   0 0 1 -386
		   0 0 0 1


}

player
{
	id 1
	matrix 1 0 0 7
	       0 1 0 110
		   0 0 1 -386
		   0 0 0 1


}



playback
{
	play 0
	record 0
	filename 04rain.scene.io
}



music
{
	# EVEN ACT -- the same track, cued at 2:02. Far enough into a 6:07 piece to
	# be another section entirely, so starting a game at act II does not open
	# on the same bars as act I.
	#
	# This cue only applies WHEN THE GAME TRACK STARTS -- coming in from the
	# home screen, which plays the other theme. Reaching act II by finishing
	# act I changes no track, so the music plays on and this number is not
	# consulted. That is deliberate (tester's spec, round 60): the cue belongs
	# to the start of a run, not to a level change.
	#
	# No `alternate`: with none declared the player LOOPS, so a long run cannot
	# run the music out -- which is what used to leave the boss in silence.
	startMusicAt 122
	trackname data/music/UNREALPM.mp3
}

title
{
	titleName  data/titles/rainTitle.png
	prolog start 2000 duration 6000

	# THE BACKSTOP, NOT THE SCHEDULE. The act normally ends on the last rule
	# (endAct, below), whenever that is. But a chain of "cleared" conditions has
	# one failure mode -- a wave that never clears -- and a level that cannot be
	# finished is worse than one that ends early. Four minutes is far past any
	# honest run of seven waves; if this fires, something is wrong, and the
	# player still gets their score screen. Whichever ending arrives first wins:
	# endAct is a one-shot and it refuses to start on top of a running epilog.
	at 240000 movePlayersToDefautlSSLocation
	epilog start 243000 duration 6000

}

# The seed, and the ONLY thing here with a time on it. Everything after it is
# in the rules block, waiting on this.
enemies
{
	settime 9000
	setttl 8000

	# Four divers, criss-crossing. The last easy thing in the act.
	at 0    spawnEnemy mouvement 1 enemyType 1 startPos -0.7 1.3 endPos 0.5 -1.3 controlPoint -0.7 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 group r1
	at 400  spawnEnemy mouvement 1 enemyType 1 startPos 0.7 1.3 endPos -0.5 -1.3 controlPoint 0.7 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 group r1
	at 800  spawnEnemy mouvement 1 enemyType 1 startPos -0.3 1.3 endPos 0.3 -1.3 controlPoint -0.3 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 group r1
	at 1200 spawnEnemy mouvement 1 enemyType 1 startPos 0.3 1.3 endPos -0.3 -1.3 controlPoint 0.3 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 group r1
}


# The act, as a chain of reactions: each rule waits for the group before it to
# be GONE -- shot down, or expired on its ttl.
#
# THE BLACK HEDGEHOGS ARE ARCHITECTURE, NOT TARGETS. subType 2 multiplies an
# FHT's energy by FORTY (event.c) and paints it 0.2 grey: forty hits from a
# bullet that deals one. You are not meant to clear them, you are meant to
# find the lane -- and the lane is where the act wants you rather than where
# you want to be. Their ttl is what advances the chain, so a wall is an
# obstacle and never a lock.
#
# THE THREE WALLS ARE DELIBERATELY SPACED. A corridor, then a fall of seekers,
# then guns in the open, then the chicane, and so on: no two formations of
# walls ever follow each other, so the act is never one long tunnel from the
# prolog to the card (tester's note, round 61).
#
# Two things to know before adding more. MAX_NUM_ENEMIES is 64, all types
# together, and the pool does not grow -- past it the engine logs "Enemy pool
# exhausted" and hands out a dummy. And NOTHING tests one enemy against
# another: a hedgehog and a Devil fly straight through each other, so a wall
# inconveniences the player and nobody else.
#
# The formation coordinates are GENERATED, not typed (tools/rain/gen_walls.awk):
# every hull in a shape has to travel the same distance in the same ttl, or the
# ones that start higher move faster and the shape shears apart on the way down.
rules
{
	# --- A: THE LONG CORRIDOR ------------------------------------------------
	# Eight hulls a side, a lane 0.64 wide. The stack is nearly two units tall,
	# so the tail is still overhead when the head has passed: you are inside it
	# for seconds, not for an instant. The two weaving divers are there so that
	# sitting in the safe lane is not free.
	setttl 15000
	rule cA when cleared r1 after 1200
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 1.35 endPos -0.32 -3.35 controlPoint -0.32 -1.00 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 1.35 endPos 0.32 -3.35 controlPoint 0.32 -1.00 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 1.63 endPos -0.32 -3.07 controlPoint -0.32 -0.72 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 1.63 endPos 0.32 -3.07 controlPoint 0.32 -0.72 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 1.91 endPos -0.32 -2.79 controlPoint -0.32 -0.44 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 1.91 endPos 0.32 -2.79 controlPoint 0.32 -0.44 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 2.19 endPos -0.32 -2.51 controlPoint -0.32 -0.16 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 2.19 endPos 0.32 -2.51 controlPoint 0.32 -0.16 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 2.47 endPos -0.32 -2.23 controlPoint -0.32 0.12 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 2.47 endPos 0.32 -2.23 controlPoint 0.32 0.12 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 2.75 endPos -0.32 -1.95 controlPoint -0.32 0.40 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 2.75 endPos 0.32 -1.95 controlPoint 0.32 0.40 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 3.03 endPos -0.32 -1.67 controlPoint -0.32 0.68 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 3.03 endPos 0.32 -1.67 controlPoint 0.32 0.68 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 3.31 endPos -0.32 -1.39 controlPoint -0.32 0.96 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 3.31 endPos 0.32 -1.39 controlPoint 0.32 0.96 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 2 xOffset 0 xWidth 0.45 enemyType 1 startPos 0 1.6 endPos 0 -1.3 controlPoint 0 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 2 xOffset 0 xWidth 0.60 enemyType 1 startPos 0 2.4 endPos 0 -1.3 controlPoint 0 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group cA

	# --- THE RED RAIN, first fall: TWELVE, ACROSS THE WHOLE WIDTH ------------
	# Homing seekers (enemyType 6), the finale boss's own weapon: a capped turn
	# rate so they can be juked, four points of hull so they can be shot down,
	# and a red-hot tint they paint on themselves every frame. Two beats from
	# two rules sharing one trigger -- a single rule fires all its spawns on
	# one tick, and twelve seekers arriving together is a wall, not weather.
	setttl 7000
	rule m1a when cleared cA after 1000
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.95 1.25 endPos -0.95 -1.3 controlPoint -0.95 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.57 1.25 endPos -0.57 -1.3 controlPoint -0.57 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.19 1.25 endPos -0.19 -1.3 controlPoint -0.19 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.19 1.25 endPos  0.19 -1.3 controlPoint  0.19 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.57 1.25 endPos  0.57 -1.3 controlPoint  0.57 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.95 1.25 endPos  0.95 -1.3 controlPoint  0.95 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group m1
	rule m1b when cleared cA after 2600
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.85 1.25 endPos -0.85 -1.3 controlPoint -0.85 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.51 1.25 endPos -0.51 -1.3 controlPoint -0.51 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.17 1.25 endPos -0.17 -1.3 controlPoint -0.17 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.17 1.25 endPos  0.17 -1.3 controlPoint  0.17 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.51 1.25 endPos  0.51 -1.3 controlPoint  0.51 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.85 1.25 endPos  0.85 -1.3 controlPoint  0.85 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group m1

	# --- the guns, in the open -----------------------------------------------
	# Three orbiting turrets with nothing to hide behind, so the act says what
	# a turret does before it starts putting walls in front of them.
	setttl 9000
	rule t1 when cleared m1 after 1300
	        spawnEnemy mouvement 0 startAngle 0   fireFrequency 50 enemyType 2 startPos -0.6 1.2 endPos -0.6 -1.2 controlPoint -0.6 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 1 bulletSpeed 3.8
	        spawnEnemy mouvement 0 startAngle 120 fireFrequency 50 enemyType 2 startPos  0.0 1.2 endPos  0.0 -1.2 controlPoint  0.0 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 1 bulletSpeed 3.8
	        spawnEnemy mouvement 0 startAngle 240 fireFrequency 50 enemyType 2 startPos  0.6 1.2 endPos  0.6 -1.2 controlPoint  0.6 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 1 bulletSpeed 3.8
	        group t1

	# --- D: THE CHICANE ------------------------------------------------------
	# The first bank fills the right half, so you go left. The second is 0.85
	# behind it and fills the left, so the gap between the two banks is exactly
	# the time you have to cross the whole screen. Two rows deep each, or it
	# reads as a line to slip past instead of a wall to go around.
	setttl 12000
	rule cD when cleared t1 after 1300
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.13 1.35 endPos 0.13 -2.45 controlPoint 0.13 -0.55 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.40 1.35 endPos 0.40 -2.45 controlPoint 0.40 -0.55 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.67 1.35 endPos 0.67 -2.45 controlPoint 0.67 -0.55 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.94 1.35 endPos 0.94 -2.45 controlPoint 0.94 -0.55 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.13 1.63 endPos 0.13 -2.17 controlPoint 0.13 -0.27 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.40 1.63 endPos 0.40 -2.17 controlPoint 0.40 -0.27 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.67 1.63 endPos 0.67 -2.17 controlPoint 0.67 -0.27 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.94 1.63 endPos 0.94 -2.17 controlPoint 0.94 -0.27 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.95 2.20 endPos -0.95 -1.60 controlPoint -0.95 0.30 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.68 2.20 endPos -0.68 -1.60 controlPoint -0.68 0.30 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.41 2.20 endPos -0.41 -1.60 controlPoint -0.41 0.30 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.14 2.20 endPos -0.14 -1.60 controlPoint -0.14 0.30 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.95 2.48 endPos -0.95 -1.32 controlPoint -0.95 0.58 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.68 2.48 endPos -0.68 -1.32 controlPoint -0.68 0.58 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.41 2.48 endPos -0.41 -1.32 controlPoint -0.41 0.58 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.14 2.48 endPos -0.14 -1.32 controlPoint -0.14 0.58 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        group cD

	# --- THE THREE DEVILS, AND SOMETHING TO DODGE WHILE YOU FIGHT THEM -------
	# One of each costume -- silver, anthracite stealth, translucent ghost --
	# 55 points of hull each and a weapon per costume, arriving with six
	# hardened hedgehogs weaving across the width. The Devils are the target;
	# the hedgehogs decide where you may stand to shoot them.
	setttl 9000
	rule d1 when cleared cD after 1500
	        spawnEnemy mouvement 1 enemyType 0 startPos -1.6 0.75 endPos -0.55 0.55 controlPoint 0 0 zAxisRot 360 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 0 startPos  1.6 0.80 endPos  0.55 0.60 controlPoint 0 0 zAxisRot 360 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 1 enemyType 0 startPos  0.0 1.60 endPos  0.00 0.78 controlPoint 0 0 zAxisRot 360 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 2 xOffset -0.80 xWidth 0.30 enemyType 1 startPos -0.80 1.4 endPos -0.80 -1.3 controlPoint -0.80 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 2 xOffset -0.48 xWidth 0.30 enemyType 1 startPos -0.48 1.7 endPos -0.48 -1.3 controlPoint -0.48 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 2 xOffset -0.16 xWidth 0.30 enemyType 1 startPos -0.16 2.0 endPos -0.16 -1.3 controlPoint -0.16 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 2 xOffset  0.16 xWidth 0.30 enemyType 1 startPos  0.16 1.4 endPos  0.16 -1.3 controlPoint  0.16 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 2 xOffset  0.48 xWidth 0.30 enemyType 1 startPos  0.48 1.7 endPos  0.48 -1.3 controlPoint  0.48 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 2 xOffset  0.80 xWidth 0.30 enemyType 1 startPos  0.80 2.0 endPos  0.80 -1.3 controlPoint  0.80 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        group d1

	# --- SECOND FALL: FOURTEEN -----------------------------------------------
	setttl 7000
	rule m2a when cleared d1 after 900
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.98 1.25 endPos -0.98 -1.3 controlPoint -0.98 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.65 1.25 endPos -0.65 -1.3 controlPoint -0.65 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.33 1.25 endPos -0.33 -1.3 controlPoint -0.33 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.00 1.25 endPos  0.00 -1.3 controlPoint  0.00 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.33 1.25 endPos  0.33 -1.3 controlPoint  0.33 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.65 1.25 endPos  0.65 -1.3 controlPoint  0.65 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.98 1.25 endPos  0.98 -1.3 controlPoint  0.98 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group m2
	rule m2b when cleared d1 after 2300
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.82 1.25 endPos -0.82 -1.3 controlPoint -0.82 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.49 1.25 endPos -0.49 -1.3 controlPoint -0.49 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.16 1.25 endPos -0.16 -1.3 controlPoint -0.16 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.16 1.25 endPos  0.16 -1.3 controlPoint  0.16 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.49 1.25 endPos  0.49 -1.3 controlPoint  0.49 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.82 1.25 endPos  0.82 -1.3 controlPoint  0.82 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.00 1.45 endPos  0.00 -1.3 controlPoint  0.00 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group m2

	# --- B: THE CORRIDOR THAT SLIDES, UNDER FIRE -----------------------------
	# The same lane as A, but every hull also travels 1.20 across while it
	# falls. Holding the middle stops being a position and becomes a drift you
	# have to keep up -- and the turrets are back to make you pay for looking
	# down at your own ship.
	setttl 13000
	rule cB when cleared m2 after 1500
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 1.35 endPos 0.88 -2.65 controlPoint 0.28 -0.65 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 1.35 endPos 1.52 -2.65 controlPoint 0.92 -0.65 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 1.63 endPos 0.88 -2.37 controlPoint 0.28 -0.37 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 1.63 endPos 1.52 -2.37 controlPoint 0.92 -0.37 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 1.91 endPos 0.88 -2.09 controlPoint 0.28 -0.09 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 1.91 endPos 1.52 -2.09 controlPoint 0.92 -0.09 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 2.19 endPos 0.88 -1.81 controlPoint 0.28 0.19 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 2.19 endPos 1.52 -1.81 controlPoint 0.92 0.19 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 2.47 endPos 0.88 -1.53 controlPoint 0.28 0.47 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 2.47 endPos 1.52 -1.53 controlPoint 0.92 0.47 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 0 startAngle 60  fireFrequency 45 enemyType 2 startPos -0.8 1.2 endPos -0.8 -1.2 controlPoint -0.8 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 1 bulletSpeed 4.0
	        spawnEnemy mouvement 0 startAngle 180 fireFrequency 45 enemyType 2 startPos  0.0 1.2 endPos  0.0 -1.2 controlPoint  0.0 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 1 bulletSpeed 4.0
	        spawnEnemy mouvement 0 startAngle 300 fireFrequency 45 enemyType 2 startPos  0.8 1.2 endPos  0.8 -1.2 controlPoint  0.8 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 1 bulletSpeed 4.0
	        group cB

	# --- the two elites, alone, so the finale lands on an empty screen -------
	setttl 9000
	rule d2 when cleared cB after 1500
	        spawnEnemy mouvement 1 enemyType 0 startPos -1.6 0.60 endPos -0.42 0.45 controlPoint 0 0 zAxisRot 360 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 1 enemyType 0 startPos  1.6 0.60 endPos  0.42 0.45 controlPoint 0 0 zAxisRot 360 xAxisRot 0 yAxisRot 0 subType 2
	        spawnEnemy mouvement 1 enemyType 3 startPos -2 0.9 endPos -0.75 0.72 controlPoint -1 1 zAxisRot 280 xAxisRot 0 yAxisRot 0 subType 0 firingAngle1 0 firingAngle2 360 numThread 6 rotAngle -200
	        spawnEnemy mouvement 1 enemyType 3 startPos  2 0.9 endPos  0.75 0.72 controlPoint  1 1 zAxisRot 280 xAxisRot 0 yAxisRot 0 subType 0 firingAngle1 0 firingAngle2 360 numThread 6 rotAngle  200
	        group d2

	# =========================================================================
	# THE STORM. The biggest wave in the game.
	#
	# Five beats in five seconds off one trigger, forty hedgehogs and twenty
	# seekers: straight down the full width, shallow diagonals both ways, then
	# hard diagonals crossing each other, with a fall of red rain laid over
	# each gap. The hedgehogs CHARGE -- ttl 5000 against the 8000 to 15000 of
	# everything else in the act, so they cross at nearly twice the speed you
	# have been reading all level.
	#
	# They are ordinary hulls, not the black architecture: subType 0 dies to
	# one bullet and 1 takes five. The biggest wave in the game has to be
	# something you shoot THROUGH, or it is just a longer wall.
	#
	# That speed is also the budget. MAX_NUM_ENEMIES is 64 and these beats
	# overlap; at ttl 5000 the first beat is gone before the last arrives, and
	# the peak lands near fifty. The smoke asserts the engine never logs
	# "Enemy pool exhausted", because past 64 a spawn silently becomes a dummy.
	setttl 5000
	rule f1 when cleared d2 after 900
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.95 1.30 endPos -0.95 -1.40 controlPoint -0.95 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.63 1.30 endPos -0.63 -1.40 controlPoint -0.63 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 1.30 endPos -0.32 -1.40 controlPoint -0.32 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.00 1.30 endPos 0.00 -1.40 controlPoint 0.00 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 1.30 endPos 0.32 -1.40 controlPoint 0.32 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.64 1.30 endPos 0.64 -1.40 controlPoint 0.64 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.95 1.30 endPos 0.95 -1.40 controlPoint 0.95 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -1.35 1.30 endPos -0.55 -1.40 controlPoint -0.95 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -1.05 1.30 endPos -0.25 -1.40 controlPoint -0.65 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.75 1.30 endPos 0.05 -1.40 controlPoint -0.35 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.45 1.30 endPos 0.35 -1.40 controlPoint -0.05 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.15 1.30 endPos 0.65 -1.40 controlPoint 0.25 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.15 1.30 endPos 0.95 -1.40 controlPoint 0.55 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.45 1.30 endPos 1.25 -1.40 controlPoint 0.85 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group storm
	rule f2 when cleared d2 after 2200
	        spawnEnemy mouvement 1 enemyType 1 startPos 1.35 1.30 endPos 0.55 -1.40 controlPoint 0.95 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 1.05 1.30 endPos 0.25 -1.40 controlPoint 0.65 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.75 1.30 endPos -0.05 -1.40 controlPoint 0.35 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
