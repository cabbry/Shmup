	at 3000 spawnEnemy mouvement 1 enemyType 1 startPos 1.3 -0.35 endPos -1.3  0.05 controlPoint 0 -0.15 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 3300 spawnEnemy mouvement 1 enemyType 1 startPos 1.3  0.05 endPos -1.3  0.05 controlPoint 0  0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	at 3600 spawnEnemy mouvement 1 enemyType 1 startPos 1.3 -0.65 endPos -1.3 -0.65 controlPoint 0 -0.65 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 3900 spawnEnemy mouvement 1 enemyType 1 startPos 1.3  0.30 endPos -1.3  0.30 controlPoint 0  0.30 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 4200 spawnEnemy mouvement 1 enemyType 1 startPos 1.3 -0.45 endPos -1.3 -0.45 controlPoint 0 -0.45 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	setttl 6000
	at 1000 spawnEnemy mouvement 1 enemyType 1 startPos 1.3  0.85 endPos -1.3 -0.20 controlPoint 0  0.90 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 2200 spawnEnemy mouvement 1 enemyType 1 startPos 1.3 -0.90 endPos -1.3  0.10 controlPoint 0 -0.90 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	setttl 5600
	at 3000 spawnEnemy mouvement 1 enemyType 0 startPos 1.4 -0.4 endPos 0.5 -0.35 controlPoint 1 -0.37 zAxisRot 360 xAxisRot 0 yAxisRot 0 subType 2

	# V8 -- CLOSING WALLS (67.5s): two five-lane hedgehog walls, offset lanes,
	# then a fast trickle. All dead straight, all fast.
	addtime 7000
	setttl 5000
	at 0    spawnEnemy mouvement 1 enemyType 1 startPos 1.3  0.80 endPos -1.3  0.80 controlPoint 0  0.80 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 250  spawnEnemy mouvement 1 enemyType 1 startPos 1.3  0.40 endPos -1.3  0.40 controlPoint 0  0.40 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	at 500  spawnEnemy mouvement 1 enemyType 1 startPos 1.3  0.00 endPos -1.3  0.00 controlPoint 0  0.00 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 750  spawnEnemy mouvement 1 enemyType 1 startPos 1.3 -0.40 endPos -1.3 -0.40 controlPoint 0 -0.40 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	at 1000 spawnEnemy mouvement 1 enemyType 1 startPos 1.3 -0.80 endPos -1.3 -0.80 controlPoint 0 -0.80 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 1600 spawnEnemy mouvement 1 enemyType 1 startPos 1.3  0.60 endPos -1.3  0.60 controlPoint 0  0.60 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 1850 spawnEnemy mouvement 1 enemyType 1 startPos 1.3  0.20 endPos -1.3  0.20 controlPoint 0  0.20 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 2100 spawnEnemy mouvement 1 enemyType 1 startPos 1.3 -0.20 endPos -1.3 -0.20 controlPoint 0 -0.20 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	at 2350 spawnEnemy mouvement 1 enemyType 1 startPos 1.3 -0.60 endPos -1.3 -0.60 controlPoint 0 -0.60 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 2600 spawnEnemy mouvement 1 enemyType 1 startPos 1.3 -1.00 endPos -1.3 -1.00 controlPoint 0 -1.00 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 3200 spawnEnemy mouvement 1 enemyType 1 startPos 1.3  0.70 endPos -1.3  0.70 controlPoint 0  0.70 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 3450 spawnEnemy mouvement 1 enemyType 1 startPos 1.3  0.30 endPos -1.3  0.30 controlPoint 0  0.30 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	at 3700 spawnEnemy mouvement 1 enemyType 1 startPos 1.3 -0.10 endPos -1.3 -0.10 controlPoint 0 -0.10 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 3950 spawnEnemy mouvement 1 enemyType 1 startPos 1.3 -0.50 endPos -1.3 -0.50 controlPoint 0 -0.50 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 4200 spawnEnemy mouvement 1 enemyType 1 startPos 1.3  0.50 endPos -1.3  0.50 controlPoint 0  0.50 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2
	at 4450 spawnEnemy mouvement 1 enemyType 1 startPos 1.3 -0.30 endPos -1.3 -0.30 controlPoint 0 -0.30 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 4700 spawnEnemy mouvement 1 enemyType 1 startPos 1.3  0.10 endPos -1.3  0.10 controlPoint 0  0.10 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 4950 spawnEnemy mouvement 1 enemyType 1 startPos 1.3 -0.70 endPos -1.3 -0.70 controlPoint 0 -0.70 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 2

	# ---------- 73-76s: tipping back. Breather. ----------

	# ---------- FINALE (78-104s, top-down): combos at full tilt ----------

	# COMBO 5: circle wave AROUND a hard spinner.
	settime 78000
	setttl 10000
	at 0    spawnEnemy mouvement 1 enemyType 3 startPos 2 0.5 endPos 0.0 0.3 controlPoint -1 1 zAxisRot 280 xAxisRot 0 yAxisRot 0 subType 1 firingAngle1 0 firingAngle2 360 numThread 7 rotAngle -120
	setttl 6000
	at 800  spawnEnemyWave circle enemyNum 12 enemyType 1 percentageInvulnerable 20 angleoffset 0 defaultType 0
	at 4500 spawnEnemyWave circle enemyNum 10 enemyType 1 percentageInvulnerable 20 angleoffset 45 defaultType 0

	# COMBO 6: twin aimed-fan SHABs WITH LEE columns between them.
	addtime 10500
	setttl 8000
	at 0    spawnEnemy mouvement 1 enemyType 3 startPos  2 0.5 endPos  0.5 0.55 controlPoint -1 1 zAxisRot 280 xAxisRot 0 yAxisRot 0 subType 0 firingAngle1 -110 firingAngle2 -35 numThread 3 rotAngle 0
	at 300  spawnEnemy mouvement 1 enemyType 3 startPos -2 0.5 endPos -0.5 0.55 controlPoint -1 1 zAxisRot 280 xAxisRot 0 yAxisRot 0 subType 0 firingAngle1 -145 firingAngle2 -70 numThread 3 rotAngle 0
	setttl 7000
	at 1000 spawnEnemy mouvement 0 startAngle 0   fireFrequency 55 enemyType 2 startPos -0.2 1.2 endPos -0.2 -1.2 controlPoint -0.2 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 1 bulletSpeed 3.5
	at 1600 spawnEnemy mouvement 0 startAngle 180 fireFrequency 55 enemyType 2 startPos  0.2 1.2 endPos  0.2 -1.2 controlPoint  0.2 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 1 bulletSpeed 3.5

	# Classic closer, act-2 flavor: sine FHT weave, one side then the other.
	addtime 9000
	setttl 4500
	at 0    spawnEnemy mouvement 2 xOffset 0 xWidth 1 enemyType 1 startPos -1 1.2 endPos -1 -1.2 controlPoint -1 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	at 600  spawnEnemy mouvement 2 xOffset 0 xWidth 1 enemyType 1 startPos  1 1.2 endPos  1 -1.2 controlPoint  1 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	at 1200 spawnEnemy mouvement 2 xOffset 0 xWidth 1 enemyType 1 startPos -1 1.2 endPos -1 -1.2 controlPoint -1 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	at 1800 spawnEnemy mouvement 2 xOffset 0 xWidth 1 enemyType 1 startPos  1 1.2 endPos  1 -1.2 controlPoint  1 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1

	# Last word: one big circle, a fifth invulnerable, spinning off-angle.
	addtime 6500
	setttl 6000
	at 0 spawnEnemyWave circle enemyNum 16 enemyType 1 percentageInvulnerable 20 angleoffset 90 defaultType 0
}

texts_events
{
	settime 0

}

events
{
	# The TTB beat. Angles are absolute (0 = upright), so a missed edit cannot
	# accumulate; each roll takes 3s, smoothstepped in camera.c.
	at 40000  ttbRoll angle 90 duration 3000
	at 73000  ttbRoll angle 0  duration 3000

	at 106000 uploadScore

}
