	        spawnEnemy mouvement 1 enemyType 1 startPos -0.17 1.55 endPos -0.17 -1.40 controlPoint -0.17 0.08 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.15 1.55 endPos 0.15 -1.40 controlPoint 0.15 0.08 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.47 1.55 endPos 0.47 -1.40 controlPoint 0.47 0.08 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
