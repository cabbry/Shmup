	        spawnEnemy mouvement 1 enemyType 3 startPos  2 0.9 endPos  0.75 0.72 controlPoint  1 1 zAxisRot 280 xAxisRot 0 yAxisRot 0 subType 0 firingAngle1 0 firingAngle2 360 numThread 6 rotAngle  200
	        group d2

	# =========================================================================
	# THE STORM. The biggest wave in the game, and the only one that fills the
	# screen rather than crossing it.
	#
	# EIGHT BANDS OF SPEED, not one block. A rule carries ONE ttl -- setttl is
	# read by this block's outer loop, never inside a rule -- so a band of
	# speed IS a rule. The distance is about 2.7 screen units, which makes the
	# ttl the speed outright: 9000 is slower than anything else in the act and
	# 3200 is nearly three times that. The first version had them all at 5000
	# and the tester called it a light breeze, correctly: forty hulls falling
	# in step read as one object.
	#
	# Mixing the speeds is also what FILLS the screen. A slow hull is still
	# falling when three fast ones have come and gone, so the count stacks --
	# which is exactly why the peak is computed rather than guessed.
	# tools/rain/gen_storm.awk walks every spawn and death in time order:
	# 85 hulls spawned, 58 alive at once at +4.6 s, against a hard cap of 64.
	# The six left over are the multiplayer squall's. Past 64 ENE_Get hands
	# out a shared dummy and the spawn quietly stops existing, so this is
	# arithmetic and not optimism.
	setttl 9000
	rule s1 when cleared d2 after 500
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.95 1.30 endPos -0.95 -1.40 controlPoint -0.95 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.74 1.30 endPos -0.74 -1.40 controlPoint -0.74 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.53 1.30 endPos -0.53 -1.40 controlPoint -0.53 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.32 1.30 endPos -0.32 -1.40 controlPoint -0.32 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.11 1.30 endPos -0.11 -1.40 controlPoint -0.11 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.10 1.30 endPos 0.10 -1.40 controlPoint 0.10 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.32 1.30 endPos 0.32 -1.40 controlPoint 0.32 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.53 1.30 endPos 0.53 -1.40 controlPoint 0.53 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.74 1.30 endPos 0.74 -1.40 controlPoint 0.74 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.95 1.30 endPos 0.95 -1.40 controlPoint 0.95 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group storm
	setttl 4500
	rule s2 when cleared d2 after 1500
