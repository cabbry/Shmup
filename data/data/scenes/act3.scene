	addtime 2000
	setttl 9000
	at 0    spawnEnemy mouvement 0 startAngle 0   fireFrequency 55 enemyType 2 startPos 1.2  0.6 endPos -1.2  0.6 controlPoint 0  0.6 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 1 bulletSpeed 3.5
