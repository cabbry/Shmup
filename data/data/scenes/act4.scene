

defaultMenu -1

# Act IV -- "Rain". THE FIRST ACT OF THE GAME THAT IS NOT ON A CLOCK.
#
# Acts I to III are timelines: every wave has an hour, and the level lasts what
# the author decided. This one is a CHAIN OF REACTIONS -- one seed wave in the
# enemies block, and after that each wave waits for the one before it to be
# gone. The consequence is the point: a party of four kills a wave faster than
# a lone player, so the act does not become a waiting room when there are more
# guns; it stays dense. Nobody tuned that. It falls out of writing "next" as a
# condition rather than a time.
#
# Its signature is the RED RAIN: three falls of homing seekers (enemyType 6),
# until now the finale boss's private weapon. They steer toward the nearest
# ship at a capped turn rate, so they are dodgeable, and they carry four points
# of hull, so they can be shot out of the sky instead. They tint themselves
# red-hot -- which against this act's grey-blue weather is the act's whole
# look. Each fall arrives in beats, from two or three rules sharing one
# trigger with different delays.
#
# It is also the exit test of the v4 pack format: written in data only, read by
# tools/packlint the way the game reads it, and it ends with a rule (endAct)
# rather than with a number.
#
# Decor, with no new asset: act 2's city and its shipped baked rail. The rail
# and the map are a PAIR -- a .cp2b stores per-frame face indices into that
# map's entities, so act 3's map (act 1's city) with act 3's rail (baked in
# 2009 for act 2's city, and 35 s long) would have culled the wrong faces on
# the wrong geometry. Act 2's flight is also the only one that shows this city
# in full: the finale spends nine seconds of it and then hovers.

map
{
	filename: data/map/act2.map
}

light
{
	enabled 0
	position : 5000 200 -5000 1
   lookAt   : 0 -200 -5000
   upVector : 1 0 0
   fov      : 70
   ambientColor  : 0.5 0.5 0.5
   diffuseColor  : 1.0 1.0 1.0

   speculaColor  : 1 1 1
   constantAttenuation: 1
   linearAttenuation: 0
   attachedToCamera: 0

}

camera
{
	path:  data/cameraPath/act2.cp.cp2b

	fov:	55
	zNear:	2
	zFar:	22000

	attachAt: 09000
	# No detachAt (4.0.2): the ships park at the end and stay visible under the
	# epilog card, like every other act.

	# A reactive act has NO KNOWN LENGTH -- it lasts as long as the players take
	# to clear seven waves, and two of them clear it faster than one. The rail
	# runs out at ~142 s, so hand over to the end-of-rail patrol instead of
	# freezing, exactly as the finale does while its fight drags on. This is the
	# camera setting that a level without a schedule requires.
	driftAtEnd: 1
}

# Rain: the city seen through weather. Same ramp start as acts 1/2 (starting it
# at the camera is what made the old act 3 needlessly dark), but the fog CLOSES
# EARLIER -- 300 against their 405 -- so the far towers dissolve and the near
# ones stay hard. Grey-blue, on the way down to the finale's deep water.
fog
{
	enabled 1
	density 0.1
	startAt 70
	endAt   300.0
	color:  0.05  0.06  0.10
}

player
{
	id 0
	matrix 1 0 0 -3
	       0 1 0 110
		   0 0 1 -386
		   0 0 0 1


}

player
{
	id 1
	matrix 1 0 0 7
	       0 1 0 110
		   0 0 1 -386
		   0 0 0 1


}



playback
{
	play 0
	record 0
	filename 04rain.scene.io
}



music
{
	# EVEN ACT -> the short theme (1:40), from the top. The acts alternate by
	# parity (round 60), so act II and act IV always open the same way. This
	# one is short enough that a long act will run past it: `alternate` hands
	# over to the other theme rather than leave the run silent.
	startMusicAt 0
	trackname data/music/UNREALTH.mp3
	alternate data/music/UNREALPM.mp3
}

title
{
	titleName  data/titles/rainTitle.png
	prolog start 2000 duration 6000

	# THE BACKSTOP, NOT THE SCHEDULE. The act normally ends on the last rule
	# (endAct, below), whenever that is. But a chain of "cleared" conditions has
	# one failure mode -- a wave that never clears -- and a level that cannot be
	# finished is worse than one that ends early. Four minutes is far past any
	# honest run of seven waves; if this fires, something is wrong, and the
	# player still gets their score screen. Whichever ending arrives first wins:
	# endAct is a one-shot and it refuses to start on top of a running epilog.
	at 240000 movePlayersToDefautlSSLocation
	epilog start 243000 duration 6000

}


# The seed, and the ONLY thing here with a time on it. Everything after it is
# in the rules block, waiting on this.
enemies
{
	settime 11000
	setttl 8000

	# Four divers, criss-crossing.
	at 0    spawnEnemy mouvement 1 enemyType 1 startPos -0.7 1.3 endPos 0.5 -1.3 controlPoint -0.7 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 group r1
	at 500  spawnEnemy mouvement 1 enemyType 1 startPos 0.7 1.3 endPos -0.5 -1.3 controlPoint 0.7 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 group r1
	at 1000 spawnEnemy mouvement 1 enemyType 1 startPos -0.3 1.3 endPos 0.3 -1.3 controlPoint -0.3 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 group r1
	at 1500 spawnEnemy mouvement 1 enemyType 1 startPos 0.3 1.3 endPos -0.3 -1.3 controlPoint 0.3 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 group r1
}


# The act. Each rule waits for the previous group to be GONE -- shot down, or
# flown off the bottom and expired (every wave carries a ttl, so a player who
# refuses to fire cannot stall the level; it just advances slower and gives
# them nothing).
rules
{
	setttl 8000

	# --- the downpour builds -------------------------------------------------
	rule r2 when cleared r1 after 1200
	        spawnEnemy mouvement 2 xOffset -0.55 xWidth 0.45 enemyType 1 startPos -0.55 1.2 endPos -0.55 -1.2 controlPoint -0.55 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 2 xOffset  0.55 xWidth 0.45 enemyType 1 startPos  0.55 1.2 endPos  0.55 -1.2 controlPoint  0.55 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 2 xOffset -0.20 xWidth 0.45 enemyType 1 startPos -0.20 1.2 endPos -0.20 -1.2 controlPoint -0.20 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 2 xOffset  0.20 xWidth 0.45 enemyType 1 startPos  0.20 1.2 endPos  0.20 -1.2 controlPoint  0.20 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group r2

	# A ring closing in -- the first moment the whole screen is busy.
	rule r3 when cleared r2 after 1200
	        spawnEnemyWave circle enemyNum 8 enemyType 1 percentageInvulnerable 0 angleoffset 0 defaultType 0
	        group r3

	# --- it starts shooting back ---------------------------------------------
	# Three turrets on their own orbits. The act's first sustained fire.
	rule r4 when cleared r3 after 1500
	        spawnEnemy mouvement 0 startAngle 0   fireFrequency 55 enemyType 2 startPos -0.6 1.2 endPos -0.6 -1.2 controlPoint -0.6 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 1 bulletSpeed 3.5
	        spawnEnemy mouvement 0 startAngle 120 fireFrequency 55 enemyType 2 startPos  0.0 1.2 endPos  0.0 -1.2 controlPoint  0.0 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 1 bulletSpeed 3.5
	        spawnEnemy mouvement 0 startAngle 240 fireFrequency 55 enemyType 2 startPos  0.6 1.2 endPos  0.6 -1.2 controlPoint  0.6 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0 1 bulletSpeed 3.5
	        group r4

	# --- THE RED RAIN, first fall --------------------------------------------
	# Homing seekers, until now the finale boss's private weapon (enemyType 6):
	# they steer at a capped turn rate toward the nearest ship, so they can be
	# juked, and they carry four points of hull, so they can also just be shot
	# out of the air. They tint themselves red-hot every frame -- and against
	# this act's grey-blue weather that is the whole picture: red rain.
	#
	# TWO rules on the SAME trigger with different delays make one volley
	# arrive in two beats. A single rule fires all its spawns on one tick,
	# which for seekers reads as a wall; a beat and a half later, as weather.
	rule m1a when cleared r4 after 1200
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.75 1.25 endPos -0.75 -1.3 controlPoint -0.75 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.00 1.25 endPos  0.00 -1.3 controlPoint  0.00 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.75 1.25 endPos  0.75 -1.3 controlPoint  0.75 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group m1
	rule m1b when cleared r4 after 2800
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.40 1.25 endPos -0.40 -1.3 controlPoint -0.40 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.40 1.25 endPos  0.40 -1.3 controlPoint  0.40 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group m1

	# A pair of spiral gunners, one from each flank.
	rule r5 when cleared m1 after 1500
	        spawnEnemy mouvement 1 enemyType 3 startPos -2 0.9 endPos -0.40 0.45 controlPoint -1 1 zAxisRot 280 xAxisRot 0 yAxisRot 0 subType 0 firingAngle1 0 firingAngle2 360 numThread 5 rotAngle -180
	        spawnEnemy mouvement 1 enemyType 3 startPos  2 0.9 endPos  0.40 0.45 controlPoint  1 1 zAxisRot 280 xAxisRot 0 yAxisRot 0 subType 0 firingAngle1 0 firingAngle2 360 numThread 5 rotAngle  180
	        group r5

	# ...and they call for help when they are half dead. A reaction to DAMAGE,
	# not to a clock: rush the pair and the escort never comes.
	rule r5b when hpBelow r5 50
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.9 1.3 endPos -0.9 -1.3 controlPoint -0.5 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos  0.9 1.3 endPos  0.9 -1.3 controlPoint  0.5 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group r5

	# --- the squall ----------------------------------------------------------
	# A hardened ring, then the last stand.
	rule r6 when cleared r5 after 1500
	        spawnEnemyWave circle enemyNum 10 enemyType 1 percentageInvulnerable 0 angleoffset 22 defaultType 1
	        group r6

	# --- second fall, heavier, and it comes in under the ring's wreckage -----
	rule m2a when cleared r6 after 1000
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.85 1.25 endPos -0.85 -1.3 controlPoint -0.85 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.28 1.25 endPos -0.28 -1.3 controlPoint -0.28 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.28 1.25 endPos  0.28 -1.3 controlPoint  0.28 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.85 1.25 endPos  0.85 -1.3 controlPoint  0.85 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group m2
	rule m2b when cleared r6 after 2400
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.60 1.25 endPos -0.60 -1.3 controlPoint -0.60 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.00 1.25 endPos  0.00 -1.3 controlPoint  0.00 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.60 1.25 endPos  0.60 -1.3 controlPoint  0.60 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group m2

	rule r7 when cleared m2 after 1800
	        spawnEnemy mouvement 1 enemyType 3 startPos -2 0.6 endPos -0.35 0.35 controlPoint -1 0.8 zAxisRot 280 xAxisRot 0 yAxisRot 0 subType 0 firingAngle1 0 firingAngle2 360 numThread 6 rotAngle -200
	        spawnEnemy mouvement 1 enemyType 3 startPos  2 0.6 endPos  0.35 0.35 controlPoint  1 0.8 zAxisRot 280 xAxisRot 0 yAxisRot 0 subType 0 firingAngle1 0 firingAngle2 360 numThread 6 rotAngle  200
	        spawnEnemy mouvement 2 xOffset -0.35 xWidth 0.5 enemyType 1 startPos -0.35 1.2 endPos -0.35 -1.2 controlPoint -0.35 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 2 xOffset  0.35 xWidth 0.5 enemyType 1 startPos  0.35 1.2 endPos  0.35 -1.2 controlPoint  0.35 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        group r7

	# --- more guns, more rain ------------------------------------------------
	# A party of three or four gets squalls the solo player never sees. The
	# trigger holds from the first tick, so "after" is what puts each squall
	# 20 s downstream of its own firing -- and it is also what makes the late
	# ones harmless: a squall queued once the act has ended is dropped with the
	# rest of the scene's events when the next one loads.
	rule squall when players 3 every 20000 after 20000
	        spawnEnemyWave circle enemyNum 5 enemyType 1 percentageInvulnerable 0 angleoffset 40 defaultType 0
	        group squall

	# --- the cloudburst ------------------------------------------------------
	# The last thing the act does: three beats, nine seekers, nothing else on
	# screen to hide behind. Then it stops raining.
	rule m3a when cleared r7 after 900
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.90 1.25 endPos -0.90 -1.3 controlPoint -0.90 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.30 1.25 endPos -0.30 -1.3 controlPoint -0.30 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.30 1.25 endPos  0.30 -1.3 controlPoint  0.30 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.90 1.25 endPos  0.90 -1.3 controlPoint  0.90 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group m3
	rule m3b when cleared r7 after 2200
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.62 1.25 endPos -0.62 -1.3 controlPoint -0.62 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.00 1.25 endPos  0.00 -1.3 controlPoint  0.00 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.62 1.25 endPos  0.62 -1.3 controlPoint  0.62 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group m3
	rule m3c when cleared r7 after 3600
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.16 1.25 endPos -0.16 -1.3 controlPoint -0.16 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.16 1.25 endPos  0.16 -1.3 controlPoint  0.16 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group m3

	# --- the ending, as a rule -----------------------------------------------
	# Two seconds of clear sky after the last seeker falls, then the ships park
	# and the card comes up. No time appears in this line, and that is the whole
	# point of the act.
	rule finish when cleared m3 after 2000
	        endAct
}
