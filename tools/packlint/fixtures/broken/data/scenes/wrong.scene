map
{
	filename data/map/there_is_no_such_map.map
}

camera
{
	path: data/cameraPath/nowhere.cp
}

enemies
{
	settime 1000
	at 0 spawnEnemy mouvement 1 enemyType 1 startPos 0 1.2 endPos 0 -1.2 controlPoint 0 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	group wave1
}

rules
{
	rule second  when cleared wave2  spawnEnemy mouvement 1 enemyType 1 startPos 0 1.2 endPos 0 -1.2 controlPoint 0 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
}

# Two more planted faults, for the checks added with the reactive act:
#  - the chain is CUT IN THE MIDDLE: 'stranded' waits on a group that only
#    'orphan' spawns, and 'orphan' itself waits on a group nothing seeds. Both
#    look well-formed to the flat "is it spawned anywhere" check.
#  - the act ends on a rule with no timed epilog behind it: one wave that never
#    clears and the level has no way out.
rules
{
	rule orphan    when cleared ghosts
	               spawnEnemy mouvement 1 enemyType 1 startPos 0 1.2 endPos 0 -1.2 controlPoint 0 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	               group limbo
	rule stranded  when cleared limbo
	               spawnEnemy mouvement 1 enemyType 1 startPos 0 1.2 endPos 0 -1.2 controlPoint 0 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	               group lost
	rule finish    when cleared lost
	               endAct
}
