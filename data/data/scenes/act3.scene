	# V7 -- THE WALL (60.5s): the 3/4-tilted spiral turret parks mid-sky, a
	# second balayeur climbs from the floor, straight lances everywhere --
	# only two gentle arcs in the whole stretch, everything else flies true.
	# The Ghost Devil shimmers in low, rippling yellow rings.
	addtime 7000
	setttl 10000
	at 0    spawnEnemy mouvement 1 enemyType 3 startPos 2 0.3 endPos 0.3 0.3 controlPoint 1 0.6 zAxisRot 280 xAxisRot 0 yAxisRot 0 subType 0 firingAngle1 0 firingAngle2 360 numThread 6 rotAngle -180
