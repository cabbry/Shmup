	        group storm
	rule f4 when cleared d2 after 4800
	        spawnEnemy mouvement 1 enemyType 1 startPos -1.50 1.30 endPos 0.50 -1.40 controlPoint -0.50 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -1.16 1.30 endPos 0.84 -1.40 controlPoint -0.16 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.82 1.30 endPos 1.18 -1.40 controlPoint 0.18 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.48 1.30 endPos 1.52 -1.40 controlPoint 0.52 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.14 1.30 endPos 1.86 -1.40 controlPoint 0.86 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.20 1.30 endPos 2.20 -1.40 controlPoint 1.20 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 1.50 1.30 endPos -0.50 -1.40 controlPoint 0.50 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 1 enemyType 1 startPos 1.16 1.30 endPos -0.84 -1.40 controlPoint 0.16 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.82 1.30 endPos -1.18 -1.40 controlPoint -0.18 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.48 1.30 endPos -1.52 -1.40 controlPoint -0.52 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.14 1.30 endPos -1.86 -1.40 controlPoint -0.86 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.20 1.30 endPos -2.20 -1.40 controlPoint -1.20 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 1
	        group storm

	setttl 6000
	rule f3 when cleared d2 after 3500
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.98 1.25 endPos -0.98 -1.3 controlPoint -0.98 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.59 1.25 endPos -0.59 -1.3 controlPoint -0.59 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.20 1.25 endPos -0.20 -1.3 controlPoint -0.20 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.20 1.25 endPos  0.20 -1.3 controlPoint  0.20 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.59 1.25 endPos  0.59 -1.3 controlPoint  0.59 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.98 1.25 endPos  0.98 -1.3 controlPoint  0.98 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.39 1.50 endPos -0.39 -1.3 controlPoint -0.39 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.39 1.50 endPos  0.39 -1.3 controlPoint  0.39 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group storm
	rule f5 when cleared d2 after 6100
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.88 1.25 endPos -0.88 -1.3 controlPoint -0.88 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.53 1.25 endPos -0.53 -1.3 controlPoint -0.53 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.18 1.25 endPos -0.18 -1.3 controlPoint -0.18 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.18 1.25 endPos  0.18 -1.3 controlPoint  0.18 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.53 1.25 endPos  0.53 -1.3 controlPoint  0.53 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.88 1.25 endPos  0.88 -1.3 controlPoint  0.88 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos -0.35 1.50 endPos -0.35 -1.3 controlPoint -0.35 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 6 startPos  0.35 1.50 endPos  0.35 -1.3 controlPoint  0.35 0 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group storm

	# --- more guns, more rain ------------------------------------------------
	# A party of three or four gets squalls the solo player never sees. The
	# trigger holds from the first tick, so "after" is what puts each squall
	# downstream of its own firing -- and it is also what makes the late ones
	# harmless: a squall queued once the act has ended is dropped with the rest
	# of the scene's events when the next one loads.
	rule squall when players 3 every 18000 after 18000
	        spawnEnemyWave circle enemyNum 6 enemyType 1 percentageInvulnerable 0 angleoffset 40 defaultType 1
	        group squall

	# --- the ending, as a rule -----------------------------------------------
	# Three seconds of clear sky after the storm's last hull falls, then the
	# ships park and the card comes up. No time appears in this line, and that
	# is the whole point of the act.
	rule finish when cleared storm after 3000
	        endAct
}
