	# --- more guns, more rain ------------------------------------------------
	# A party of three or four gets squalls the solo player never sees. The
	# trigger holds from the first tick, so "after" is what puts each squall
	# downstream of its own firing -- and it is also what makes the late ones
	# harmless: a squall queued once the act has ended is dropped with the rest
	# of the scene's events when the next one loads.
	rule squall when players 3 every 18000 after 18000
	        spawnEnemyWave circle enemyNum 6 enemyType 1 percentageInvulnerable 0 angleoffset 40 defaultType 1
	        group squall

	# --- the ending, as a rule -----------------------------------------------
	# Three seconds of clear sky after the storm's last hull falls, then the
	# ships park and the card comes up. No time appears in this line, and that
	# is the whole point of the act.
	rule finish when cleared storm after 3000
	        endAct
}
