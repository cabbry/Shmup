	setttl 5600
	at 2500 spawnEnemy mouvement 1 enemyType 0 startPos 1.4 0.45 endPos 0.5 0.4 controlPoint 1 0.42 zAxisRot 360 xAxisRot 0 yAxisRot 0 subType 0

	# X-CROSS (51.5s): straight diagonals crossing mid-screen -- lances from
	# every direction at once, no curve anywhere.
	addtime 6500
	setttl 5000
	at 0    spawnEnemy mouvement 1 enemyType 1 startPos 1.3  0.85 endPos -1.3 -0.55 controlPoint 0  0.15 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	at 250  spawnEnemy mouvement 1 enemyType 1 startPos 1.3 -0.85 endPos -1.3  0.55 controlPoint 0 -0.15 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
