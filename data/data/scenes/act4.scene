	# =========================================================================
	# THE STORM. The biggest wave in the game, and the only one that fills the
	# screen rather than crossing it.
	#
	# EIGHT BANDS OF SPEED, not one block. A rule carries ONE ttl, so a band of
	# speed IS a rule. The distance is about 2.7 screen units, which makes the
	# ttl the speed outright: 7000 is act I's charging-column speed (0.4 u/s)
	# and 3200 is more than twice that. Nothing in the storm is slower than
	# the columns the tester pointed at.
	#
	# AND IT CONVERGES. Every hull's end X is pulled toward the centre of the
	# floor, where the player lives, so the outer lanes angle IN instead of
	# falling past in parallel. A hedgehog cannot aim -- only the seekers home
	# -- but a formation can be aimed, and this one is.
	#
	# Mixing the speeds is also what FILLS the screen: a slow hull is still
	# falling when three fast ones have come and gone, so the count stacks --
	# which is why the peak is computed rather than guessed.
	# tools/rain/gen_storm.awk walks every spawn and death in time order and
	# prints the answer; it is kept at 60 against a hard cap of 64, with the
	# multiplayer squall trimmed to 4 so the two together cannot exceed it.
	setttl 7000
	rule s1 when cleared d2 after 500
	        spawnEnemy mouvement 1 enemyType 1 startPos -1.10 1.30 endPos -0.39 -1.40 controlPoint -0.74 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.86 1.30 endPos -0.30 -1.40 controlPoint -0.58 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.61 1.30 endPos -0.21 -1.40 controlPoint -0.41 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.37 1.30 endPos -0.13 -1.40 controlPoint -0.25 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos -0.12 1.30 endPos -0.04 -1.40 controlPoint -0.08 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.12 1.30 endPos 0.04 -1.40 controlPoint 0.08 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.36 1.30 endPos 0.13 -1.40 controlPoint 0.25 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.61 1.30 endPos 0.21 -1.40 controlPoint 0.41 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 0.85 1.30 endPos 0.30 -1.40 controlPoint 0.58 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        spawnEnemy mouvement 1 enemyType 1 startPos 1.10 1.30 endPos 0.38 -1.40 controlPoint 0.74 -0.05 zAxisRot 0 xAxisRot 0 yAxisRot 0 subType 0
	        group storm
	setttl 4500
	rule s2 when cleared d2 after 1500
